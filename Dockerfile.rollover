FROM node:22-alpine

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable \
  && addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 rollover

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --prod --frozen-lockfile

COPY scripts/close-stale-runs.mjs ./scripts/close-stale-runs.mjs

USER rollover

CMD ["node", "scripts/close-stale-runs.mjs"]
